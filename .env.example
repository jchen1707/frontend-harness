# Copy to .env and fill in. .env is gitignored — never commit real secrets.
#
# IMPORTANT: only variables prefixed with VITE_ are inlined into the browser
# bundle and are therefore PUBLIC. Never put a secret behind a VITE_ prefix.
# Real secrets (API keys) belong on a server/build step, not in client code.

# --- Browser-exposed (public) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_GRAPHQL_URL=http://localhost:8000/graphql
VITE_LOG_LEVEL=info
# Set to true once a backend is wired up; the skeleton leaves it off so a
# fresh clone makes no failing health request on load.
VITE_HEALTHCHECK_ENABLED=false
# Turn on to run the browser mock worker in dev; keep off in production builds.
VITE_MOCK_API=false

# --- Server / build-side only (NOT VITE_ prefixed, never sent to the browser) ---
# Anthropic (any AI features must run server-side; do not expose this key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# GitHub (PR / release automation)
GH_TOKEN=

# --- Read by agent harnesses, NOT by the app ---
# The Linear MCP key is deliberately absent from this file, and from every environment
# variable. An environment variable is inherited by the Bash tool, so `echo $VAR` would
# print the key into the transcript, and a key in a transcript needs rotating.
#
# It lives in the OS credential store instead. Both MCP adapters name one shared launcher.
# The launcher fetches the value at connection time. Store it once with the command in
# docs/secrets.md §5; nothing here needs filling in.
#
# Create the key at: Linear -> Settings -> Security & access -> Personal API keys
