# Copy to .env and fill in. .env is gitignored — never commit real secrets.
#
# IMPORTANT: only variables prefixed with VITE_ are inlined into the browser
# bundle and are therefore PUBLIC. Never put a secret behind a VITE_ prefix.
# Real secrets (API keys) belong on a server/build step, not in client code.

# --- Browser-exposed (public) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_GRAPHQL_URL=http://localhost:8000/graphql
VITE_LOG_LEVEL=info
# Set to true once a backend is wired up; the skeleton leaves it off so a
# fresh clone makes no failing health request on load.
VITE_HEALTHCHECK_ENABLED=false

# --- Server / build-side only (NOT VITE_ prefixed, never sent to the browser) ---
# Anthropic (any AI features must run server-side; do not expose this key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# GitHub (PR / release automation)
GH_TOKEN=

# --- Read by Claude Code, NOT by the app ---
# Linear MCP (.mcp.json) authenticates with this key. A Linear personal API key
# belongs to the workspace it was created in, which is what binds this repo to one
# workspace and stops it drifting onto another.
#
# IMPORTANT: Claude Code expands ${LINEAR_API_KEY} from the *environment*, not from
# this file. Copying it into .env alone does nothing.
#
# Set it as an OS user environment variable. Do NOT put the value in
# ~/.claude/settings.json -> "env". That block keeps the key out of git, but it leaves
# the literal in a plaintext file the agent reads for unrelated reasons. One full-file
# read copies the key into the transcript, and the key then needs a rotation.
# Never put it in this repo's committed .claude/settings.json, which every clone reads.
#
# docs/secrets.md gives the command that sets it without touching shell history.
# Create one at: Linear -> Settings -> Security & access -> Personal API keys
LINEAR_API_KEY=
