# Copy to .env and fill in. .env is gitignored — never commit real secrets.
#
# IMPORTANT: only variables prefixed with VITE_ are inlined into the browser
# bundle and are therefore PUBLIC. Never put a secret behind a VITE_ prefix.
# Real secrets (API keys) belong on a server/build step, not in client code.

# --- Browser-exposed (public) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_GRAPHQL_URL=http://localhost:8000/graphql
VITE_LOG_LEVEL=info
# Set to true once a backend is wired up; the skeleton leaves it off so a
# fresh clone makes no failing health request on load.
VITE_HEALTHCHECK_ENABLED=false

# --- Server / build-side only (NOT VITE_ prefixed, never sent to the browser) ---
# Anthropic (any AI features must run server-side; do not expose this key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# GitHub (PR / release automation)
GH_TOKEN=
