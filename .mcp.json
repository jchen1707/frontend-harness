{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--redact-network-headers",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "docker-toolkit": {
      "command": "docker",
      "args": ["mcp", "gateway", "run"]
    }
  }
}
