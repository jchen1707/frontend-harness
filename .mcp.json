{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--redact-network-headers",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "typescript-lsp": {
      "command": "mcp-language-server",
      "args": ["--workspace", ".", "--lsp", "typescript-language-server", "--", "--stdio"]
    }
  }
}
