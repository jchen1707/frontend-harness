{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--redact-network-headers",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp",
      "headersHelper": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/mcp-headers.mjs\" linear-fro"
    }
  }
}
