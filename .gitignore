# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
*.local

# Test / tooling artifacts
coverage/
playwright-report/
test-results/
.lighthouseci/
.vite/

# Environment (NEVER commit real secrets)
.env
.env.*
!.env.example

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Claude Code — personal/local only (shared config is committed)
.claude/settings.local.json
.claude/.credentials.json
.claude/scheduled_tasks.json
.agents/plans/
.claude/plans/
.claude/todos/

# .agents/skills/ contains canonical repo skills. .claude/skills/ contains adapters.
# .claude/agents/, hooks/, commands/, and workflows/ are Claude Code adapters. Third-party skills come from the
# mattpocock-skills plugin, declared in .claude/settings.json → enabledPlugins; the
# plugin's own files live outside the repo under ~/.claude/plugins/ and must never be
# vendored back in here.
