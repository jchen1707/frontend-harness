{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build)",
      "Bash(pnpm preview:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lhci)",
      "Bash(pnpm exec:*)",
      "Bash(npx playwright:*)",
      "Bash(npx lhci:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git merge-base:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh api:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Bash(cat .env:*)",
      "Bash(cat ./.env:*)",
      "Bash(source .env:*)",
      "Bash(type .env:*)",
      "Bash(more .env:*)",
      "Bash(less .env:*)",
      "Bash(head .env:*)",
      "Bash(tail .env:*)",
      "Bash(nl .env:*)",
      "Bash(strings .env:*)",
      "Bash(Get-Content .env:*)",
      "Bash(gc .env:*)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(set)",
      "Bash(export)",
      "Bash(export -p:*)",
      "Bash(declare -x:*)",
      "Bash(typeset -x:*)",
      "Bash(compgen -e:*)",
      "Bash(Get-ChildItem Env:*)",
      "Bash(gci Env:*)",
      "Bash(ls Env:*)",
      "Bash(dir Env:*)",
      "Bash(Get-Variable:*)",
      "Bash(echo $LINEAR_API_KEY:*)",
      "Bash(echo \"$LINEAR_API_KEY\":*)",
      "Bash(echo ${LINEAR_API_KEY}:*)",
      "Bash(echo $env:LINEAR_API_KEY:*)",
      "Bash(echo $GH_TOKEN:*)",
      "Bash(echo \"$GH_TOKEN\":*)",
      "Bash(echo ${GH_TOKEN}:*)",
      "Bash(echo $env:GH_TOKEN:*)",
      "Bash(python -c:*)",
      "Bash(python3 -c:*)",
      "Bash(node -e:*)",
      "Bash(node -p:*)"
    ]
  },
  "enabledPlugins": {
    "harness@harness": true,
    "mattpocock-skills@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "plansDirectory": ".claude/plans",
  "enabledMcpjsonServers": ["chrome-devtools", "docker-toolkit"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|mcp__.*(edit|write|create|apply).*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_paths.mjs"],
            "timeout": 30,
            "statusMessage": "Checking protected paths\u2026"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|mcp__.*(edit|write|create|apply).*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format_edited.mjs"],
            "timeout": 120,
            "statusMessage": "Formatting\u2026"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/verify.mjs"],
            "timeout": 600,
            "statusMessage": "Verifying Definition of Done\u2026"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session_learnings.mjs"],
            "timeout": 300,
            "statusMessage": "Distilling session learnings\u2026"
          }
        ]
      }
    ]
  }
}
